{
  "name": "admindb",
  "version": "2.2.0",
  "description": "Browser-based SQLite & PostgreSQL database administration tool — embed it in your Express app or run it standalone.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "admindb": "dist/cli.js"
  },
  "homepage": "https://github.com/MIbnEKhalid/admindb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIbnEKhalid/admindb.git"
  },
  "bugs": {
    "url": "https://github.com/MIbnEKhalid/admindb/issues"
  },
  "author": "MIbnEKhalid",
  "files": [
    "dist",
    "docs",
    "!docs/screenshots",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs && npm run build:css",
    "build:css": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./src/public/css/input.css -o ./dist/public/css/app.css --minify",
    "start": "node dist/cli.js -d ./db",
    "dev": "concurrently -k -n server,css \"tsx watch src/cli.ts -d ./db\" \"npm run dev:css\"",
    "dev:css": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "test:smoke": "tsx --test test/smoke.test.ts",
    "generatehash": "node scripts/generate-hash.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "lint": "tsc --noEmit",
    "testapp": "node testapp/server.js"
  },
  "keywords": [
    "sqlite",
    "postgres",
    "postgresql",
    "admin",
    "database",
    "express",
    "handlebars",
    "tailwind",
    "daisyui"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.0",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

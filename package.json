{
  "name": "admindb",
  "version": "1.0.2",
  "description": "Browser-based SQLite database administration tool — embed it in your Express app or run it standalone.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "admindb": "dist/cli.js"
  },
  "homepage": "https://github.com/MIbnEKhalid/admindb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIbnEKhalid/admindb.git"
  },
  "bugs": {
    "url": "https://github.com/MIbnEKhalid/admindb/issues"
  },
  "author": "MIbnEKhalid",
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && npm run build:css",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./dist/public/css/app.css --minify",
    "start": "node dist/cli.js",
    "dev": "concurrently -k -n server,css \"tsx watch src/cli.ts\" \"npm run dev:css\"",
    "dev:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "sqlite",
    "admin",
    "database",
    "express",
    "handlebars",
    "tailwind",
    "daisyui"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "daisyui": "^4.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

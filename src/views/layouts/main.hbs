{{!-- Layout: Main Application Wrapper (renders all pages via {{{body}}}) --}}
<!DOCTYPE html>
<html lang="en" data-theme="admindb">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}} · AdminDB</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{basePath}}/css/app.css" />
  <script>
    window.APP = {
      basePath: {{{json basePath}}},
      readonly: {{{json readonly}}},
      serverless: {{{json serverless}}},
      dialect: {{{json dialect}}},
      isSqlite: {{{json isSqlite}}},
      isPostgres: {{{json isPostgres}}}
    };
    // Apply the saved theme before first paint to avoid a flash.
    (function () {
      try {
        var t = localStorage.getItem('admindb-theme');
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'admindbDark');
      } catch (e) {}
    })();
  </script>
  <script>
    window.AdminIcons = {
      map: {{{json icons}}},
      get: function(name, customClass) {
        var svg = this.map[name] || '';
        if (!svg || !customClass) return svg;
        if (svg.indexOf('class="') !== -1) {
          return svg.replace(/class="[^"]*"/, 'class="' + customClass + '"');
        }
        return svg.replace('<svg', '<svg class="' + customClass + '"');
      }
    };
  </script>
  <script src="{{basePath}}/js/common.js" defer></script>
  <script src="{{basePath}}/js/api.js" defer></script>
  <script src="{{basePath}}/js/app.js" defer></script>
  <script src="{{basePath}}/js/inspector.js" defer></script>

</head>
<body class="min-h-screen bg-base-200 text-base-content">
  {{#if readonly}}
    <div class="flex items-center justify-center gap-2 bg-warning/15 px-4 py-2 text-center text-sm font-semibold text-warning">
      <span class="shrink-0">{{{icon "warning" class="h-4 w-4"}}}</span>
      {{#if serverless}}
        Serverless mode active — database is open in read-only mode. Writes and schema modifications are disabled.
      {{else}}
        Read-only mode — this database is open without write access. All writes are disabled.
      {{/if}}
    </div>
  {{/if}}
  {{#if noSidebar}}
    <div class="flex min-h-screen flex-col">
      {{> navbar}}
      <main class="mx-auto w-full max-w-[1500px] flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        {{{body}}}
      </main>
      <footer class="border-t border-base-300 px-6 py-4 text-center text-xs text-base-content/40">
        AdminDB{{#if version}} v{{version}}{{/if}} · SQLite & PostgreSQL database administration
      </footer>
    </div>
  {{else}}
    <div class="drawer lg:drawer-open">
      <input id="sidebar-toggle" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-screen flex-col">
        {{> navbar}}
        <main class="mx-auto w-full max-w-[1500px] flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          {{{body}}}
        </main>
        <footer class="border-t border-base-300 px-6 py-4 text-center text-xs text-base-content/40">
          AdminDB{{#if version}} v{{version}}{{/if}} · SQLite & PostgreSQL database administration
        </footer>
      </div>

      <div class="drawer-side z-40">
        <label for="sidebar-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
        {{> sidebar}}
      </div>
    </div>
  {{/if}}
  <div id="toast-container" class="pointer-events-none fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4"></div>
</body>
</html>

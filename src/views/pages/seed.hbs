<div class="space-y-5">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <a href="{{basePath}}/tables/{{table}}" class="btn btn-circle btn-ghost btn-sm" aria-label="Back to table">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </a>
      <div>
        <h1 class="font-mono text-2xl font-bold tracking-tight">{{table}}</h1>
        <p class="text-sm text-base-content/55">Data generator — fill the table with realistic rows in one transaction.</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      {{#unless readonly}}
        <button id="seed-preview" type="button" class="btn btn-outline btn-sm gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          Preview SQL
        </button>
        <button id="seed-insert" type="button" class="btn btn-primary btn-sm gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Insert rows
        </button>
      {{else}}
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-warning">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          Read-only — you can preview generated SQL but not insert rows.
        </span>
      {{/unless}}
    </div>
  </div>

  <!-- Row count -->
  <div class="app-card p-4">
    <div class="flex flex-wrap items-end gap-x-5 gap-y-3">
      <div class="form-control w-44">
        <label class="field-label" for="seed-count">Rows to generate</label>
        <input id="seed-count" type="number" min="1" max="{{maxRows}}" value="10" class="field-input" />
      </div>
      <div class="flex items-center gap-1.5 pb-0.5">
        {{#each quickCounts}}
          <button type="button" class="seed-quick btn btn-outline btn-xs" data-n="{{this}}">{{this}}</button>
        {{/each}}
      </div>
      <p class="pb-0.5 text-xs text-base-content/45">Up to <b class="tabular-nums">{{maxRows}}</b> rows. The insert is transactional — a failed row rolls everything back.</p>
    </div>
  </div>

  <!-- Column strategies -->
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-base-content/45">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
      Column strategies
    </h2>
    <div class="flex flex-wrap items-center gap-1.5">
      <button id="seed-apply-all" type="button" class="btn btn-ghost btn-xs gap-1">Apply strategy to all…</button>
      <button id="seed-reset" type="button" class="btn btn-ghost btn-xs gap-1">Reset defaults</button>
    </div>
  </div>
  <div id="seed-columns" class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3"></div>

  <!-- Feedback (warnings) -->
  <div id="seed-feedback" class="hidden"></div>

  <!-- Generated SQL preview -->
  <div id="seed-sql" class="hidden">
    <div class="app-card">
      <div class="flex items-center justify-between border-b border-base-200 px-5 py-3.5">
        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-base-content/45">
          <span class="grid h-6 w-6 place-items-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </span>
          Generated SQL
        </h2>
        <button id="seed-copy" type="button" class="btn btn-ghost btn-xs gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h9a2 2 0 002-2v-2m-4-7h3a2 2 0 012 2v9a2 2 0 01-2 2h-3" /></svg>
          Copy
        </button>
      </div>
      <div class="p-4">
        <pre class="code-panel max-h-[32rem] overflow-auto"><code id="seed-sql-code"></code></pre>
      </div>
    </div>
  </div>
</div>
<script id="seed-config" type="application/json">{{{json seedConfig}}}</script>
<script src="{{basePath}}/js/seed.js" defer></script>

{{!-- Page: Database Overview Dashboard · URL: / (or /{basePath}/) --}}
<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">Overview</p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight">Database</h1>
      <p class="mt-1.5 text-sm text-base-content/55">Browse, edit, and query the connected database from your browser.</p>
    </div>
    <div class="flex gap-2">
      <a href="{{basePath}}/query" class="btn btn-ghost btn-sm gap-1.5">
        {{{icon "query" class="h-4 w-4"}}}
        Query
      </a>
      {{#unless readonly}}
        <a href="{{basePath}}/designer" class="btn btn-primary btn-sm gap-1.5">
          {{{icon "plus" class="h-4 w-4"}}}
          New table
        </a>
      {{/unless}}
    </div>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="stat-card">
      <span class="stat-icon bg-primary/10 text-primary">
        {{{icon "table" class="h-6 w-6"}}}
      </span>
      <div>
        <div class="text-2xl font-extrabold tabular-nums">{{tables.length}}</div>
        <div class="text-[13px] text-base-content/50">Tables</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon bg-secondary/10 text-secondary">
        {{{icon "stats" class="h-6 w-6"}}}
      </span>
      <div>
        <div class="text-2xl font-extrabold tabular-nums">{{totalRows}}</div>
        <div class="text-[13px] text-base-content/50">Total rows</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon bg-accent/10 text-accent">
        {{{icon "seed" class="h-6 w-6"}}}
      </span>
      <div>
        <div class="text-2xl font-extrabold tabular-nums">{{savedQueries}}</div>
        <div class="text-[13px] text-base-content/50">Saved queries</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon {{#if isPostgres}}bg-info/10 text-info{{else}}bg-emerald-500/10 text-emerald-500{{/if}}">
        {{{icon "database" class="h-6 w-6"}}}
      </span>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="text-xl font-extrabold">{{dialectName}}</span>
          {{#if readonly}}
            <span class="rounded bg-warning/20 px-1.5 py-0.5 text-[10px] font-bold uppercase text-warning">Read-only</span>
          {{else}}
            <span class="rounded bg-success/20 px-1.5 py-0.5 text-[10px] font-bold uppercase text-success">Writable</span>
          {{/if}}
        </div>
        <div class="truncate font-mono text-xs text-base-content/50" title="{{dbPath}}">{{dbPath}}</div>
      </div>
    </div>
  </div>

  <!-- Tables -->
  <div>
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-bold">Tables</h2>
      <span class="text-sm text-base-content/45">{{tables.length}} total</span>
    </div>

    {{#if tables.length}}
      <div class="app-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr class="bg-base-200/70 text-xs uppercase tracking-wide text-base-content/50">
                <th class="font-semibold">Table</th>
                <th class="text-right font-semibold">Columns</th>
                <th class="text-right font-semibold">Rows</th>
                <th class="text-right font-semibold">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each tables}}
                <tr class="group hover:bg-base-200/50">
                  <td>
                    <a href="{{../basePath}}/tables/{{this}}" class="inline-flex items-center gap-2.5 font-medium">
                      <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
                        {{{icon "table" class="h-4 w-4"}}}
                      </span>
                      <span class="font-mono text-[13.5px]">{{this}}</span>
                    </a>
                  </td>
                  <td class="text-right tabular-nums text-base-content/60">{{lookup ../cols this}}</td>
                  <td class="text-right tabular-nums text-base-content/60">{{lookup ../counts this}}</td>
                  <td class="text-right">
                    <a href="{{../basePath}}/tables/{{this}}" class="btn btn-ghost btn-xs gap-1 text-base-content/70 hover:text-primary">
                      Browse
                      {{{icon "arrowRight" class="h-3.5 w-3.5"}}}
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{else}}
      <div class="empty-state">
        <span class="empty-icon">
          {{{icon "table" class="h-7 w-7"}}}
        </span>
        <p class="text-sm font-medium text-base-content/70">No tables yet</p>
        <p class="max-w-sm text-sm text-base-content/45">Create one with the table designer, or run a SQL statement in the query editor to get started.</p>
        <div class="mt-2 flex gap-2">
          {{#unless readonly}}
            <a href="{{basePath}}/designer" class="btn btn-primary btn-sm">New table</a>
          {{/unless}}
          <a href="{{basePath}}/query" class="btn btn-outline btn-sm">Query editor</a>
        </div>
      </div>
    {{/if}}
  </div>
</div>

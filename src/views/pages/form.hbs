<div class="mx-auto max-w-3xl space-y-5">
  <!-- Header -->
  <div class="flex items-center gap-3">
    <a href="{{basePath}}/tables/{{table}}" class="btn btn-circle btn-ghost btn-sm" aria-label="Back to table">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold tracking-tight">
        {{#if (eq mode 'edit')}}Edit row{{else}}New row{{/if}}
        <span class="text-base-content/40">in</span> <span class="font-mono text-primary">{{table}}</span>
      </h1>
      <p class="text-sm text-base-content/55">{{infoSummary}}</p>
    </div>
  </div>

  <div class="app-card">
    <div class="border-b border-base-200 px-6 py-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/45">Row fields</h2>
    </div>
    <div class="p-6">
      <div id="row-fields" class="grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-2"></div>
      <div id="form-error" class="hidden"></div>
      <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-base-200 pt-5">
        {{#unless readonly}}
          <button id="row-submit" type="button" class="btn btn-primary">
            {{#if (eq mode 'edit')}}Update row{{else}}Insert row{{/if}}
          </button>
          <button id="row-generate" type="button" class="btn btn-outline gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
            Get query
          </button>
        {{else}}
          <span class="text-sm font-medium text-warning">This database is read-only — rows cannot be {{#if (eq mode 'edit')}}updated{{else}}inserted{{/if}}.</span>
        {{/unless}}
        <a href="{{basePath}}/tables/{{table}}" class="btn btn-ghost">Cancel</a>
      </div>
      <p class="mt-3 text-xs text-base-content/40">
        Columns with defaults are pre-filled from the schema. Empty fields are treated as "not set" (DB defaults
        apply). <code class="font-mono">0</code> is a valid value. "Get query" only previews the SQL — it never executes.
      </p>
    </div>
  </div>

  <div id="generated-sql" class="hidden">
    <div class="app-card">
      <div class="flex items-center justify-between border-b border-base-200 px-6 py-4">
        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-base-content/45">
          <span class="grid h-6 w-6 place-items-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </span>
          Generated SQL
        </h2>
        <button id="copy-sql" type="button" class="btn btn-ghost btn-xs gap-1">Copy</button>
      </div>
      <div class="p-4">
        <pre class="code-panel"><code id="generated-sql-code"></code></pre>
      </div>
    </div>
  </div>
</div>
<script id="form-config" type="application/json">{{{json config}}}</script>
<script src="{{basePath}}/js/forms.js" defer></script>

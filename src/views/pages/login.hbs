<div class="flex min-h-[75vh] items-center justify-center py-6 px-4">
  <div class="w-full max-w-md">
    <!-- Brand Header -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary shadow-soft">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7M4 7c0-1.1.9-2 2-2h12a2 2 0 012 2M4 7c0 1.1.9 2 2 2h12a2 2 0 002-2" />
        </svg>
      </div>
      <h1 class="text-2xl font-extrabold tracking-tight text-base-content sm:text-3xl">
        Admin<span class="text-primary">DB</span>
      </h1>
      <p class="mt-1 text-sm text-base-content/60">
        Sign in to access your SQLite database administration console
      </p>
    </div>

    <!-- Login Card -->
    <div class="app-card border border-base-300/80 bg-base-100 p-6 sm:p-8 shadow-soft">
      {{#if error}}
        <div class="mb-6 flex items-start gap-3 rounded-xl bg-error/10 p-4 text-sm text-error border border-error/20" role="alert">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div class="font-medium">{{error}}</div>
        </div>
      {{/if}}

      {{#if isDefaultPassword}}
        <div class="mb-6 rounded-xl bg-info/10 p-3.5 text-xs text-info border border-info/20">
          <div class="font-semibold flex items-center gap-1.5 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Default Credentials Active
          </div>
          <p class="text-base-content/70">
            Username: <code class="font-mono font-semibold text-primary">admin</code> · Password: <code class="font-mono font-semibold text-primary">admin</code>
          </p>
          <p class="mt-1 text-[11px] text-base-content/50">
            Set <code class="font-mono">ADMINDB_PASSWORD</code> in production to secure your console.
          </p>
        </div>
      {{/if}}

      <form method="POST" action="{{basePath}}/login" class="space-y-4">
        {{#if next}}
          <input type="hidden" name="next" value="{{next}}" />
        {{/if}}

        <div>
          <label class="field-label" for="login-username">
            <span>Username</span>
          </label>
          <div class="relative">
            <input
              id="login-username"
              type="text"
              name="username"
              value="{{#if username}}{{username}}{{else}}admin{{/if}}"
              required
              autofocus
              placeholder="Username"
              class="field-input pl-10"
              autocomplete="username"
            />
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          </div>
        </div>

        <div>
          <label class="field-label" for="login-password">
            <span>Password</span>
          </label>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              name="password"
              required
              placeholder="••••••••"
              class="field-input pl-10"
              autocomplete="current-password"
            />
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="btn btn-primary w-full gap-2 font-semibold shadow-soft">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            Sign In
          </button>
        </div>
      </form>
    </div>

    <!-- Security & Auth Control Note -->
    <div class="mt-6 text-center text-xs text-base-content/50">
      Authentication can be turned off anytime via <code class="font-mono">--no-auth</code> or <code class="font-mono">auth: false</code>.
    </div>
  </div>
</div>

{{!-- Page: Authentication & Login · URL: /login --}}
<div class="flex min-h-[75vh] items-center justify-center py-6 px-4">

  <div class="w-full max-w-md">
    <!-- Brand Header -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary shadow-soft">
        {{{icon "database" class="h-8 w-8"}}}
      </div>
      <h1 class="font-headings text-2xl font-extrabold tracking-tight text-base-content sm:text-3xl">
        Admin<span class="text-primary">DB</span>
      </h1>
      <p class="mt-1 text-sm text-base-content/60">
        Sign in to access your database administration console
      </p>
    </div>

    <!-- Login Card -->
    <div class="app-card border bg-base-100/90 p-6 sm:p-8 shadow-card backdrop-blur-md">
      {{#if error}}
        <div class="mb-6 flex items-start gap-3 rounded-xl bg-error/10 p-4 text-sm text-error border border-error/20" role="alert">
          <span class="shrink-0 mt-0.5">
            {{{icon "warning" class="h-5 w-5"}}}
          </span>
          <div class="font-medium">{{error}}</div>
        </div>
      {{/if}}

      {{#if isDefaultPassword}}
        <div class="mb-6 rounded-xl bg-info/10 p-3.5 text-xs text-info border border-info/20">
          <div class="font-semibold flex items-center gap-1.5 mb-1">
            {{{icon "warning" class="h-4 w-4 shrink-0"}}}
            Default Credentials Active
          </div>
          <p class="text-base-content/70">
            Username: <code class="font-mono font-semibold text-primary">admin</code> · Password: <code class="font-mono font-semibold text-primary">admin</code>
          </p>
          <p class="mt-1 text-[11px] text-base-content/50">
            Set <code class="font-mono">ADMINDB_PASSWORD</code> in production to secure your console.
          </p>
        </div>
      {{/if}}

      <form method="POST" action="{{basePath}}/login" class="space-y-4">
        {{#if next}}
          <input type="hidden" name="next" value="{{next}}" />
        {{/if}}

        <div>
          <label class="field-label" for="login-username">
            <span>Username</span>
          </label>
          <div class="relative">
            <input
              id="login-username"
              type="text"
              name="username"
              value="{{#if username}}{{username}}{{else}}admin{{/if}}"
              required
              autofocus
              placeholder="Username"
              class="field-input pl-10"
              autocomplete="username"
            />
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
              {{{icon "user" class="h-5 w-5"}}}
            </div>
          </div>
        </div>

        <div>
          <label class="field-label" for="login-password">
            <span>Password</span>
          </label>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              name="password"
              required
              placeholder="••••••••"
              class="field-input pl-10"
              autocomplete="current-password"
            />
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
              {{{icon "lock" class="h-5 w-5"}}}
            </div>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="btn btn-primary w-full gap-2 font-semibold shadow-soft">
            {{{icon "logout" class="h-4 w-4 rotate-180"}}}
            Sign In
          </button>
        </div>
      </form>
    </div>

    <!-- Security & Auth Control Note -->
    <div class="mt-6 space-y-2 text-center text-xs text-base-content/55">
      <p class="leading-relaxed">
        <span class="font-semibold text-base-content/80">Security Notice:</span> Built-in auth provides basic access control. For production, protect your admin routes using your own application authentication, VPN, or reverse proxy.
      </p>
      <p class="text-base-content/40">
        Native authentication can be disabled via <code class="font-mono">--no-auth</code> or <code class="font-mono">auth: false</code>.
      </p>
    </div>
  </div>
</div>


{{!-- Page: Error Display · URL: HTTP 404 / 500 Error Handlers --}}
<div class="mx-auto mt-16 max-w-md space-y-6 text-center">

  <div class="mx-auto grid h-20 w-20 place-items-center rounded-3xl bg-error/10 text-error">
    {{{icon "warning" class="h-10 w-10"}}}
  </div>
  <div>
    <h1 class="text-5xl font-extrabold tracking-tight text-error">{{status}}</h1>
    <p class="mt-2 text-base-content/60">{{error}}</p>
  </div>
  <a href="{{basePath}}/" class="btn btn-primary">Back to home</a>
</div>

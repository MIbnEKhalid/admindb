<div class="space-y-6">
  <!-- Header -->
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Manager</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight">Databases</h1>
    <p class="mt-1.5 text-sm text-base-content/55">Open a database to browse and edit it, or create a new one.</p>
  </div>

  <!-- New database -->
  <div class="app-card p-5">
    <div class="flex flex-wrap items-end gap-3">
      <div class="w-full max-w-sm">
        <label class="field-label" for="new-db-name">New database name</label>
        <input id="new-db-name" class="field-input font-mono" placeholder="e.g. analytics" autocomplete="off" spellcheck="false" />
      </div>
      {{#unless readonly}}
        <button id="create-db" type="button" class="btn btn-primary btn-sm mb-0.5 gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          Create
        </button>
      {{else}}
        <span class="mb-1 text-sm font-medium text-warning">Read-only — creating databases is disabled.</span>
      {{/unless}}
    </div>
    <p class="mt-2 text-xs text-base-content/40">
      New databases are created in <code class="font-mono">{{dbDir}}</code>. Files already there are picked up
      automatically, and any explicitly configured database paths appear here too.
    </p>
  </div>

  <!-- Open an existing database file -->
  {{#if allowBrowse}}
    <div class="app-card p-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/45">Open an existing database</h2>
        <span class="text-xs text-base-content/40">.db · .sqlite · .sqlite3</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <input id="fs-path" class="field-input font-mono sm:!w-96" placeholder="Absolute path to a folder, e.g. C:\data" autocomplete="off" spellcheck="false" />
        <button id="fs-go" type="button" class="btn btn-outline btn-sm gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          Go
        </button>
        <button id="fs-up" type="button" class="btn btn-ghost btn-sm gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h13M3 10l4-4m-4 4l4 4" /></svg>
          Up
        </button>
      </div>
      <div class="mt-3 overflow-hidden rounded-xl border border-base-300">
        <div id="fs-current" class="border-b border-base-200 bg-base-200/50 px-3 py-2 font-mono text-xs text-base-content/60"></div>
        <div id="fs-listing" class="max-h-80 divide-y divide-base-200/70 overflow-auto"></div>
      </div>
      <p class="mt-2.5 text-xs text-base-content/45">
        Browse the filesystem to select an existing database; opening it adds it to the list above so you can
        switch between databases freely.
        {{#if browseRoot}}
          <span class="font-medium text-base-content/60">Browsing is limited to <code class="font-mono">{{browseRoot}}</code>.</span>
        {{/if}}
        <span class="font-medium text-warning">This server has no authentication — treat it like a remote filesystem &amp; database shell.</span>
      </p>
    </div>
  {{else}}
    <div class="app-card p-5">
      <p class="text-sm text-base-content/60">
        <b class="text-base-content/80">File browsing is disabled.</b>
        This server was started with specific database files, so the filesystem browser is turned off — use the
        list of available databases below.
      </p>
    </div>
  {{/if}}

  <!-- List -->
  <div>
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-bold">Available databases</h2>
      <span class="text-sm text-base-content/45">{{databases.length}} total</span>
    </div>

    {{#if databases.length}}
      <div class="app-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr class="bg-base-200/70 text-xs uppercase tracking-wide text-base-content/50">
                <th class="font-semibold">Name</th>
                <th class="text-right font-semibold">Tables</th>
                <th class="text-right font-semibold">Size</th>
                <th class="font-semibold">Modified</th>
                <th class="text-right font-semibold">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each databases}}
                <tr class="group hover:bg-primary/[0.04]">
                  <td>
                    <a href="{{../basePath}}/{{this.id}}" class="inline-flex items-center gap-2.5">
                      <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7M4 7c0-1.1.9-2 2-2h12a2 2 0 012 2M4 7c0 1.1.9 2 2 2h12a2 2 0 002-2" /></svg>
                      </span>
                      <span class="min-w-0">
                        <span class="block truncate font-mono text-[13.5px] font-semibold">{{this.name}}</span>
                        <span class="block max-w-[220px] truncate text-[11px] text-base-content/40" title="{{this.path}}">{{this.path}}</span>
                      </span>
                    </a>
                  </td>
                  <td class="text-right tabular-nums text-base-content/60">{{this.tables}}</td>
                  <td class="text-right tabular-nums text-base-content/60">{{this.sizeLabel}}</td>
                  <td class="text-[13px] text-base-content/55">{{this.modifiedLabel}}</td>
                  <td class="whitespace-nowrap text-right">
                      <div class="row-actions">
                        <a href="{{../basePath}}/{{this.id}}" class="btn btn-ghost btn-xs gap-1 text-base-content/70 hover:text-primary">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                          Open
                        </a>
                        {{#unless ../readonly}}
                          <button type="button" class="btn btn-ghost btn-xs gap-1 text-error js-delete-db" data-id="{{this.id}}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            Delete
                          </button>
                        {{/unless}}
                      </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{else}}
      <div class="empty-state">
        <span class="empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7M4 7c0-1.1.9-2 2-2h12a2 2 0 012 2M4 7c0 1.1.9 2 2 2h12a2 2 0 002-2" /></svg>
        </span>
        <p class="text-sm font-medium text-base-content/70">No databases yet</p>
        <p class="max-w-sm text-sm text-base-content/45">
          Create one above, or drop <code class="font-mono">.db</code> files into
          <code class="font-mono">{{dbDir}}</code> and refresh.
        </p>
      </div>
    {{/if}}
  </div>
</div>
<script src="{{basePath}}/js/databases.js" defer></script>

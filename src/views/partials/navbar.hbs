{{!-- Partial: Top Navigation Bar Header --}}
<div class="sticky top-0 z-30 border-b border-base-300/80 bg-base-100/85 backdrop-blur-md">

  <div class="navbar mx-auto w-full max-w-[1500px] px-4 sm:px-6 lg:px-8">
    <div class="flex-none lg:hidden">
      <label for="sidebar-toggle" class="btn btn-square btn-ghost" aria-label="open sidebar">
        {{{icon "menu" class="h-5 w-5"}}}
      </label>
    </div>
    <div class="flex flex-1 items-center gap-3">
      <a href="{{basePath}}/" class="flex items-center gap-2.5">
        <span class="font-headings text-lg font-bold tracking-tight text-base-content">Admin<span class="text-primary">DB</span></span>
      </a>
      {{#unless databasesMode}}
        {{#if isPostgres}}
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-info/40 bg-info/10 px-2.5 py-0.5 text-xs font-semibold text-info" title="Engine: PostgreSQL ({{dbPath}})">
            <span class="h-2 w-2 rounded-full bg-info animate-pulse"></span>
            PostgreSQL
          </span>
        {{else}}
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400" title="Engine: SQLite ({{dbPath}})">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            SQLite
          </span>
        {{/if}}

        <button id="global-search-trigger" type="button" class="btn btn-ghost btn-sm gap-2 border border-base-300 bg-base-200/60 hover:bg-base-200 text-base-content/70 hover:text-base-content font-normal text-xs rounded-xl px-3 py-1.5 h-auto transition-all shadow-xs sm:ml-2" title="Search tables, columns, commands (Ctrl+K)">
          {{{icon "search" class="h-3.5 w-3.5 text-base-content/50"}}}
          <span class="hidden md:inline font-medium text-base-content/70">Search tables, columns…</span>
          <span class="inline md:hidden font-medium text-base-content/70">Search</span>
          <kbd class="hidden sm:inline-flex items-center gap-0.5 rounded border border-base-300 bg-base-100 px-1.5 py-0.5 text-[10px] font-mono text-base-content/60 font-semibold shadow-xs">
            <span class="text-[9px]">Ctrl</span> K
          </kbd>
        </button>
      {{/unless}}
    </div>

    <div class="flex items-center gap-1.5">
      {{#unless noSidebar}}
        {{#unless databasesMode}}
          {{#if databasesUrl}}
            <a href="{{databasesUrl}}" class="btn btn-ghost btn-sm hidden gap-1.5 sm:inline-flex">
              {{{icon "database" class="h-4 w-4"}}}
              Databases
            </a>
          {{/if}}
          <a href="{{basePath}}/query/{{encodeUri dbId}}" class="btn btn-ghost btn-sm hidden gap-1.5 sm:inline-flex">
            {{{icon "query" class="h-4 w-4"}}}
            Query
          </a>
          {{#unless readonly}}
            <a href="{{basePath}}/designer/{{encodeUri dbId}}" class="btn btn-ghost btn-sm hidden gap-1.5 sm:inline-flex">
              {{{icon "plus" class="h-4 w-4"}}}
              New table
            </a>
          {{/unless}}
          <a href="{{basePath}}/export/{{encodeUri dbId}}" class="btn btn-ghost btn-sm hidden gap-1.5 md:inline-flex">
            {{{icon "export" class="h-4 w-4"}}}
            Export
          </a>
        {{/unless}}
      {{/unless}}

      {{#if authEnabled}}
        {{#if authUser}}
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-sm gap-1.5 normal-case font-medium">
              {{{icon "user" class="h-4 w-4 text-base-content/70"}}}
              <span class="max-w-[120px] truncate text-xs">{{authUser}}</span>
            </label>
            <ul tabindex="0" class="dropdown-content menu p-2 shadow-soft bg-base-100 rounded-xl w-56 border border-base-300 z-50 mt-1 text-sm space-y-1">
              <li class="menu-title px-2 py-1 text-xs text-base-content/50">Signed in as <strong class="text-base-content">{{authUser}}</strong></li>
              {{#if isDefaultPassword}}
                <li class="rounded-lg bg-warning/10 p-2 text-[11px] text-warning border border-warning/20">
                  <div class="flex items-center gap-1.5 font-semibold p-0">
                    {{{icon "warning" class="h-3.5 w-3.5 shrink-0"}}}
                    <span>Default pass active (admin)</span>
                  </div>
                </li>
              {{/if}}
              <li>
                <form method="POST" action="{{basePath}}/logout" class="p-0">
                  <button type="submit" class="w-full text-left flex items-center gap-2 px-3 py-2 text-error hover:bg-error/10 rounded-lg">
                    {{{icon "logout" class="h-4 w-4"}}}
                    Sign out
                  </button>
                </form>
              </li>
            </ul>
          </div>
        {{/if}}
      {{/if}}

      <button id="theme-toggle" type="button" class="btn btn-square btn-ghost btn-sm" aria-label="Toggle dark mode" title="Toggle dark mode">
        {{{icon "moon" class="h-5 w-5"}}}
      </button>

    </div>
  </div>
</div>

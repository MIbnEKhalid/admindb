{{!-- Partial: Left Navigation Sidebar --}}
<aside class="flex h-full min-h-full w-72 flex-col bg-neutral text-neutral-content">

  <div class="flex items-center gap-2.5 px-5 pb-4 pt-5">
    <div class="w-full">
      <div class="flex items-center justify-between">
        <div class="font-headings text-base font-bold leading-tight">AdminDB <span style="font-size: x-small" class="font-sans font-normal opacity-70">{{#if version}}v{{version}}{{/if}}</span></div>
        {{#unless databasesMode}}
          {{#if isPostgres}}
            <span class="rounded bg-info/20 px-1.5 py-0.5 text-[10px] font-bold text-info">PostgreSQL</span>
          {{else}}
            <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-bold text-emerald-400">SQLite</span>
          {{/if}}
        {{/unless}}
      </div>
      <div class="mt-0.5 text-[11px] text-neutral-content/50 truncate">{{#if databasesMode}}Database manager{{else}}{{dbId}}{{/if}}</div>
    </div>
  </div>

  {{#if databasesMode}}
  <nav class="flex-1 overflow-y-auto px-3 py-2">
    <ul class="space-y-0.5">
      <li>
        <a href="{{basePath}}/" class="side-link {{#if (eq currentPath '/')}}active{{/if}}">
          {{{icon "database" class="h-4 w-4"}}}
          Databases
        </a>
      </li>
      <li>
        <a href="{{basePath}}/diff" class="side-link {{#if (startsWith currentPath '/diff')}}active{{else}}{{#if (startsWith currentPath '/sync')}}active{{/if}}{{/if}}">
          {{{icon "diff" class="h-4 w-4"}}}
          Diff & Replicate
        </a>
      </li>
    </ul>
  </nav>
  {{else}}
  <div class="px-4 pb-2">
    <label class="relative block">
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-neutral-content/40">
        {{{icon "search" class="h-4 w-4"}}}
      </span>
      <input id="table-search" type="search" placeholder="Filter tables…" autocomplete="off"
        class="w-full rounded-lg border border-white/10 bg-white/[0.06] py-2 pl-9 pr-3 text-sm text-neutral-content outline-none transition placeholder:text-neutral-content/40 focus:border-primary/70 focus:ring-4 focus:ring-primary/20" />
    </label>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-2">
    <ul class="space-y-0.5">
      {{#if databasesUrl}}
      <li>
        <a href="{{databasesUrl}}" class="side-link">
          {{{icon "database" class="h-4 w-4"}}}
          Databases
        </a>
      </li>
      {{/if}}
      <li>
        <a href="{{basePath}}/home/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/home')}}active{{/if}}">
          {{{icon "home" class="h-4 w-4"}}}
          Home
        </a>
      </li>
      <li>
        <a href="{{basePath}}/query/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/query')}}active{{/if}}">
          {{{icon "query" class="h-4 w-4"}}}
          Query editor
        </a>
      </li>
      <li>
        <a href="{{basePath}}/erd/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/erd')}}active{{/if}}">
          {{{icon "diagram" class="h-4 w-4"}}}
          ER Diagram
        </a>
      </li>
      <li>
        <a href="{{basePath}}/seed/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/seed')}}active{{/if}}">
          {{{icon "seed" class="h-4 w-4"}}}
          Seed generator
        </a>
      </li>
      <li>
        <a href="{{basePath}}/diff/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/diff')}}active{{else}}{{#if (startsWith currentPath '/sync')}}active{{/if}}{{/if}}">
          {{{icon "diff" class="h-4 w-4"}}}
          Diff & Replicate
        </a>
      </li>
      <li>
        <a href="{{basePath}}/info/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/info')}}active{{/if}}">
          {{{icon "settings" class="h-4 w-4"}}}
          Info & Settings
        </a>
      </li>
      {{#unless readonly}}
      <li>
        <a href="{{basePath}}/designer/{{encodeUri dbId}}" class="side-link {{#if (startsWith currentPath '/designer')}}active{{/if}}">
          {{{icon "plus" class="h-4 w-4"}}}
          New table
        </a>
      </li>
      {{/unless}}
    </ul>

    <div class="mb-2 mt-6 flex items-center justify-between px-3">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-content/40">Tables</span>
      <span id="table-count" class="rounded-md bg-white/[0.06] px-1.5 py-0.5 text-[10px] font-semibold text-neutral-content/50">{{tables.length}}</span>
    </div>

    <ul id="table-list" class="space-y-0.5">
      {{#each tables}}
      <li class="table-item" data-name="{{tableName this}}">
        <a href="{{../basePath}}/tables/{{encodeUri ../dbId}}/{{encodeUri (tableName this)}}" class="side-link {{#if (eq ../currentTable (tableName this))}}active{{/if}}">
          <span class="table-icon">
            {{{icon "table" class="h-4 w-4"}}}
          </span>
          <span class="truncate">{{tableName this}}</span>
        </a>
      </li>
      {{else}}
      <li class="px-3 py-2 text-xs text-neutral-content/40">No tables yet</li>
      {{/each}}
    </ul>
  </nav>
  {{/if}}

  {{#if isDefaultPassword}}
  <div class="border-t border-white/10 px-4 py-2 bg-warning/10">
    <div class="flex items-center justify-between text-warning text-xs font-semibold">
      <span class="flex items-center gap-1.5 font-mono text-[11px]">
        {{{icon "warning" class="h-3.5 w-3.5 shrink-0"}}}
        default pass active
      </span>
      <span class="badge badge-warning badge-xs font-mono font-bold">admin</span>
    </div>
  </div>
  {{/if}}

  <div class="border-t border-white/10 px-5 py-3">
    <div class="flex items-center justify-between">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-content/40">{{#if databasesMode}}Directory{{else}}Engine: {{dialectName}}{{/if}}</div>
      {{#unless databasesMode}}
        {{#if readonly}}
          <span class="rounded bg-warning/20 px-1.5 py-0.5 text-[9px] font-bold uppercase text-warning">Read-only</span>
        {{else}}
          <span class="rounded bg-success/20 px-1.5 py-0.5 text-[9px] font-bold uppercase text-success">Writable</span>
        {{/if}}
      {{/unless}}
    </div>
    <div class="mt-0.5 truncate font-mono text-[11px] text-neutral-content/60" title="{{dbPath}}">{{dbPath}}</div>
  </div>
</aside>
